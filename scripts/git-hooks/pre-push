#!/usr/bin/env bash
# Local pre-push hook — runs the project's quality gate BEFORE the
# global secrets-scanning pre-push hook. This is the LOCAL hook that
# every repo installs. The global secrets-scanning hook is in
# ~/.git-templates/hooks/pre-push (managed by opencode-config).
#
# Architecture (two layers, intentionally separate):
#   1. THIS file: project's quality gate (ruff + pyright + pytest +
#      complexipy + branch-coverage-on-changed-files + mutation-testing-on-changed-tracked-functions)
#   2. CHAINED file: ~/.git-templates/hooks/pre-push (gitleaks,
#      semgrep, trufflehog, detect-secrets).
#
# The mutation-testing gate is FAST when no tracked function changed
# (sub-second via mutmut's function_hashes cache — only re-tests
# mutants whose source function changed). It is SLOW only when a
# tracked function actually changed — exactly when you want the gate.
# This is the org's standard pattern: mutation testing is local-only
# at pre-push, NOT in CI. See opencode-config SKILL.md for rationale.
#
# Bypass (emergency only): git push --no-verify
set -euo pipefail

# --- PATH shim: ensure uv is on PATH ---
# uv-installed tools are under ~/.local/bin which is not on PATH for
# non-interactive subshells (git hooks, editor git-buffers, AI agents).
# Add it here so make can find uv without requiring the hook to be
# sourced from an interactive shell.
export PATH="$HOME/.local/bin:$PATH"

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- 1. PROJECT QUALITY GATE: make pre-push-validate ---
# `pre-push-validate` runs `validate` (CI-mirrored fast gates) PLUS
# `validate-branch` (branch coverage on changed files) PLUS
# `mutate-changed` (mutation testing on changed tracked functions).
# Mandatory: push fails if any gate fails. Full bypass via --no-verify.
if [ -f "$REPO_ROOT/Makefile" ] && command -v make >/dev/null 2>&1; then
  echo "pre-push: running make pre-push-validate (lint + type + complexity + tests + branch coverage + mutation)..." >&2
  if ! (cd "$REPO_ROOT" && make pre-push-validate); then
    echo "pre-push: quality gate FAILED. Fix the gate and retry, or push with --no-verify." >&2
    exit 1
  fi
else
  echo "pre-push: no Makefile or make not on PATH — skipping project quality gate." >&2
fi

# --- 2. SECRETS SCANNING: defer to the global pre-push template ---
GLOBAL_HOOK="/home/antonio/.git-templates/hooks/pre-push"
if [ -x "$GLOBAL_HOOK" ] && [ "$(readlink -f "$GLOBAL_HOOK")" != "$(readlink -f "$0")" ]; then
  exec "$GLOBAL_HOOK" "$@"
fi

{
  "default": true,
  // Rules ENABLED (catches real bugs that affect rendering):
  //   MD022/blank-lines-around-headings
  //   MD024/no-duplicate-heading  (siblings_only — sub-section duplicates allowed)
  //   MD025/single-title
  //   MD031/blanks-around-fences
  //   MD032/blanks-around-lists
  //   MD034/no-bare-urls
  //   MD036/no-emphasis-as-heading
  //   MD040/fenced-code-language
  //   MD041/first-line-heading  (with front_matter_title exemption)
  //   MD046/code-block-style
  //   MD049/emphasis-style
  //   MD050/strong-style

  // Rules DISABLED (style-only, would create noise on existing files):
  //   MD004 ul-style
  //   MD007 ul-indent
  //   MD009 no-trailing-spaces  (pre-commit trailing-whitespace covers this)
  //   MD010 no-hard-tabs        (pre-commit mixed-line-ending covers this)
  //   MD012 no-multiple-blanks
  //   MD013 line-length         (too noisy — real docs are often wide)
  //   MD026 no-trailing-punctuation
  //   MD030 list-marker-space
  //   MD033 inline-html         (AGENTS.md, docs use HTML intentionally)
  //   MD035 hr-style
  //   MD045 no-alt-text         (intentional shields.io badges, etc.)
  //   MD060 table-column-style  (style — most tables already render fine)

  "MD013": false,
  "MD033": false,
  "MD007": false,
  "MD030": false,
  "MD004": false,
  "MD012": false,
  "MD026": false,
  "MD035": false,
  "MD060": false,
  "MD024": { "siblings_only": true },
  "MD041": { "front_matter_title": "^\\s*title\\s*[:=]" },
  "MD045": false
}
